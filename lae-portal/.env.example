MONDAY_TOKEN=
MONDAY_API_VERSION=2025-01
CACHE_TTL=300
PORTALES={}

VRM_TOKEN=
POLL_SEGUNDOS=60
VENTANA_MINUTOS=20
SITIOS={}

# WhatsApp (Twilio) -- resumen automático tras cada apagón. Opcional: si falta
# cualquiera de estas 4, el poller de apagones se queda desactivado (no truena).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_APAGON=

# CLIENTES: config unificada por cliente para /mi/<token>.
# Cada cliente puede traer board_id (monday), vrm_id + banco_kwh (VRM), o ambos.
# "sistema", "documentos", "seriales", "marcas", "saldo", "logistica", "calendario",
# "cfe_bolsa"/"cfe_ancla" e "idioma" son opcionales y manuales.
# "marcas" controla qué logos de fabricante se muestran al pie (valores: "victron", "bsl").
# "logistica" es una lista de envíos; "estado" es "pendiente", "en_transito" o "entregado".
# "calendario" es una lista de días/actividades; "dentro_casa": true resalta que el
# equipo va a estar dentro de la casa ese día.
# "logistica" y "calendario" solo se muestran mientras la obra esté abierta (board_id presente).
# "cfe_bolsa" (kWh de banco de energía) + "cfe_ancla" (fecha ISO del último corte real de CFE)
# activan la tarjeta "Tu próximo recibo de CFE" -- requieren vrm_id.
# "idioma": "es" (default) o "en" -- solo traduce la interfaz, no datos de monday/config.
# Ejemplo:
# CLIENTES={"<token-secreto>": {
#   "nombre": "Casa Juan Pablo", "cliente": "Juan Pablo", "ubicacion": "Tulum, Q. Roo",
#   "board_id": "18423973736",
#   "vrm_id": 901035, "banco_kwh": 30.72, "soc_minimo": 10,
#   "sistema": {"topologia": "...", "solar": {}, "potencia": {}},
#   "documentos": [{"tipo": "Contrato", "nombre": "Contrato de instalación", "url": "https://..."}],
#   "seriales": [{"equipo": "Inversor Victron Quattro 10kVA", "modelo": "...",
#                 "serie": "...", "garantia_hasta": "2029-08-10"}],
#   "marcas": ["victron", "bsl"],
#   "saldo": {"total": 450000, "pagado": 300000},
#   "logistica": [{"item": "Baterías BSL + inversores", "origen": "Tulum", "destino": "Monterrey",
#                  "estado": "en_transito", "guia": "1Z999AA10123456784", "fecha_estimada": "2026-08-20"}],
#   "calendario": [{"fecha": "18 ago", "actividad": "Cableado interior", "dentro_casa": true},
#                  {"fecha": "19 ago", "actividad": "Instalación de paneles", "dentro_casa": false}],
#   "cfe_bolsa": 235.0, "cfe_ancla": "2026-06-22",
#   "whatsapp_avisos": "+5219981234567",
#   "idioma": "en"
# }}
CLIENTES={}
